PROJECT_NAME=Mock Full Stack FastAPI Template Backend
ENVIRONMENT=local
API_V1_STR=/api/v1

FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=11520

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=full_stack_fastapi
MYSQL_CONNECT_TIMEOUT=10
MYSQL_POOL_NAME=app_pool
MYSQL_POOL_SIZE=5
MYSQL_AUTO_CREATE_DATABASE=false
MYSQL_AUTO_CREATE_TABLES=true
MYSQL_SEED_LOCAL_DATA=true
